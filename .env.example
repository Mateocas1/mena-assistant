# ── Telegram ────────────────────────────────────────────────────────────────
# Token from @BotFather. Never commit a real token.
TELEGRAM_BOT_TOKEN=

# Allowlist: comma-separated `chatId:profile`. Profiles: romi | mateo.
# Get your chat id by talking to the bot and reading the audit line, or with
# @userinfobot. Any chat not listed here gets no reply and no LLM call.
TELEGRAM_ALLOWLIST=123456789:romi,987654321:mateo

# ── LLM (OpenAI-compatible) ─────────────────────────────────────────────────
LLM_BASE_URL=https://api.nan.builders/v1
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
LLM_FALLBACK_MODEL=glm5.3-flash
LLM_TIMEOUT_MS=30000
LLM_MAX_TOOL_CALLS=6

# ── Booking backend (30a) ───────────────────────────────────────────────────
# M0 only ships the mock adapter; `http` lands in M1.
TURNOS_ADAPTER=mock
ASSISTANT_BASE_URL=
ASSISTANT_TOKEN=

# ── Feature flags ───────────────────────────────────────────────────────────
FEATURE_TURNOS=true
FEATURE_STOCK=false
FEATURE_TAREAS=false

# ── Behaviour ───────────────────────────────────────────────────────────────
PROPOSAL_TTL_MINUTES=10
