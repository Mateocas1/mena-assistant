# ── Telegram ────────────────────────────────────────────────────────────────
# Token from @BotFather. Never commit a real token.
TELEGRAM_BOT_TOKEN=

# Allowlist: comma-separated `chatId:profile`. Profiles: romi | mateo.
# Get your chat id by talking to the bot and reading the audit line, or with
# @userinfobot. Any chat not listed here gets no reply and no LLM call.
TELEGRAM_ALLOWLIST=123456789:romi,987654321:mateo

# ── LLM (OpenAI-compatible) ─────────────────────────────────────────────────
LLM_BASE_URL=https://api.nan.builders/v1
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
LLM_FALLBACK_MODEL=glm5.3-flash
LLM_TIMEOUT_MS=30000
LLM_MAX_TOOL_CALLS=6

# ── Booking backend (30a) ───────────────────────────────────────────────────
# `mock` serves fixtures (dev/CI). `http` calls the real /assistant/* actions.
TURNOS_BACKEND=mock
# Convex .convex.site origin, e.g. https://shiny-fox-123.convex.site
ASSISTANT_API_BASE_URL=
ASSISTANT_TOKEN=
TURNOS_TIMEOUT_MS=10000

# ── Feature flags ───────────────────────────────────────────────────────────
FEATURE_TURNOS=true
FEATURE_STOCK=false
FEATURE_TAREAS=false

# ── Tareas (Mateo's planner, PRD 30c) ──────────────────────────────────────
# `mock` keeps the planner in memory; `firestore` uses the Admin SDK confined to
# users/{MATEO_FIREBASE_UID} (Application Default Credentials).
TAREAS_BACKEND=mock
MATEO_FIREBASE_UID=
FIREBASE_PROJECT_ID=

# ── Traces (optional) ──────────────────────────────────────────────────────
# Unset disables tracing entirely (the default). Set it to your OTLP HTTP
# collector, e.g. http://langfuse:4318 or http://localhost:4318.
OTEL_EXPORTER_OTLP_ENDPOINT=

# ── Behaviour ───────────────────────────────────────────────────────────────
PROPOSAL_TTL_MINUTES=10
# When set, the audit log is appended there as JSONL (`pnpm metrics <file>`).
AUDIT_LOG_FILE=
# Offline healthcheck: heartbeat file touched every HEALTH_INTERVAL_SECONDS.
HEALTH_FILE=/tmp/mena-assistant-alive
HEALTH_INTERVAL_SECONDS=30

# ── Daily summary + backend health alert ────────────────────────────────────
# 08:00 ART summary pushed to every allow-listed chat (no LLM, read data only).
DAILY_SUMMARY_ENABLED=true
DAILY_SUMMARY_HOUR=8
# Health alert: after N consecutive failed probes, one message to Mateo (and one
# recovery message). Off by default in dev. Chat defaults to the first `mateo`.
HEALTH_ALERT_ENABLED=false
HEALTH_ALERT_INTERVAL_SECONDS=300
HEALTH_ALERT_FAILURES=3
HEALTH_ALERT_CHAT_ID=
